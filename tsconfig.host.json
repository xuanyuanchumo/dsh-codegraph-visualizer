{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "noEmit": true,
    "declaration": true,
    "outDir": "dist-host",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "plugins": []
  },
  "include": [
    "src/index.ts",
    "src/adapters/**/*",
    "src/merger/**/*",
    "src/tools/**/*",
    "src/push/**/*",
    "src/types/**/*",
    "src/events.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-host", "dist-client", "src/client"]
}