{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/tools.ts",
    "src/adapters/**/*",
    "src/merger/**/*",
    "src/types/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-host", "dist-client", "src/client", "tests"]
}