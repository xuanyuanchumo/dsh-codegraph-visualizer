{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/tools.ts",
    "src/graphUtils.ts",
    "src/adapters/**/*",
    "src/merger/**/*",
    "src/types/**/*",
    "src/shared/**/*",
    "src/xuanji/**/*",
    "src/host/**/*",
    "src/generated/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-host", "dist-client", "src/client", "tests"]
}