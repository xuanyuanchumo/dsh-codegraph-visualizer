{
  "name": "dsh-codegraph-visualizer",
  "version": "2.0.0",
  "description": "DSH 代码图谱可视化插件 - 打通 dsh-codegraph/dsh-tool-lens 数据源 → Cytoscape.js 渲染",
  "type": "module",
  "license": "MIT",
  "author": "DSH Team",
  "engines": {
    "node": ">=22.19 || >=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "tsdown src/index.ts --format esm --dts --outDir dist",
    "build": "tsdown src/index.ts --format esm --dts --outDir dist --minify",
    "build:host": "tsdown src/index.ts --format esm --dts --outDir dist-host --platform node",
    "build:client": "tsdown src/client/index.ts --format esm --dts --outDir dist-client --platform browser",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:web": "playwright test --project=chromium",
    "lint": "oxlint src/",
    "duplication": "cpx 'src/**/*.ts' temp/ && jscpd temp/",
    "hygiene": "publint dist && node scripts/consume-check.mjs",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run hygiene"
  },
  "dependencies": {
    "@deepseek-cordis/plugin": "^0.1.1-rc.2",
    "cytoscape": "^3.26.0",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-grid-guide": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "oxlint": "^9.0.0",
    "playwright": "^1.50.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "peerDependencies": {
    "dsh-codegraph": ">=0.1.1-rc.2",
    "dsh-tool-lens": ">=0.1.1-rc.2",
    "react": "^19.0.0"
  },
  "keywords": ["dsh", "codegraph", "visualizer", "cytoscape", "code-analysis"],
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    }
  },
  "dsh": {
    "name": "dsh-codegraph-visualizer",
    "version": "2.0.0",
    "profile": "web",
    "entry": "dist/index.js",
    "clientEntry": "dist/client/index.js",
    "capabilities": ["graph_visualizer", "graph_data_adapter"],
    "events": [
      "codegraph/repo/imported",
      "codegraph/repo/scanned",
      "codegraph/graph/updated",
      "codegraph/search/result",
      "codegraph/nav/jump"
    ]
  }
}