{
  "name": "dsh-codegraph-visualizer",
  "version": "0.2.0",
  "description": "DSH 代码图谱可视化插件 - 打通 dsh-codegraph/dsh-tool-lens 数据源 → 聚合转换 → 交互式代码图谱",
  "type": "module",
  "license": "MIT",
  "author": "DSH Team",
  "engines": {
    "node": ">=22.19 || >=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "main": "dist/index.js",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "pnpm run sync-version",
    "build": "tsdown src/index.ts --format esm --dts --outDir dist && pnpm run build:client",
    "build:host": "tsdown src/index.ts --format esm --dts --outDir dist-host --platform node",
    "build:client": "node scripts/build-client.mjs",
    "dev": "node scripts/dev-server.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "typecheck:host": "tsc -p tsconfig.host.json",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:web": "playwright test --project=chromium",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "hygiene": "publint dist && node scripts/consume-check.mjs",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "tree-sitter-wasm": "^1.1.8",
    "web-tree-sitter": "^0.27.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/coverage-v8": "^3.0.0",
    "cytoscape": "^3.26.0",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-fcose": "^2.2.0",
    "jsdom": "^30.7.1",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.0"
  },
  "keywords": [
    "dsh",
    "codegraph",
    "visualizer",
    "cytoscape",
    "code-analysis"
  ],
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "hostVersion": ">=0.1.1-rc.2 <0.2.0",
    "permissions": {
      "workspace": true,
      "network": true,
      "fs": "readonly"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
