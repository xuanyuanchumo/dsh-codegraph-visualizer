{
  "name": "dsh-codegraph-visualizer",
  "version": "2.1.0",
  "description": "DSH 代码图谱可视化插件 - 打通 dsh-codegraph/dsh-tool-lens 数据源 → 聚合转换 → 交互式代码图谱",
  "type": "module",
  "license": "MIT",
  "author": "DSH Team",
  "engines": {
    "node": ">=22.19 || >=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --outDir dist",
    "build:host": "tsdown src/index.ts --format esm --dts --outDir dist-host --platform node",
    "typecheck": "tsc -p tsconfig.host.json",
    "typecheck:host": "tsc -p tsconfig.host.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:web": "playwright test --project=chromium",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "hygiene": "publint dist && node scripts/consume-check.mjs",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run hygiene"
  },
  "dependencies": {
    "cytoscape": "^3.26.0",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-grid-guide": "^2.3.3",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.50.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "dsh",
    "codegraph",
    "visualizer",
    "cytoscape",
    "code-analysis"
  ],
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}