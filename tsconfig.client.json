{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "isolatedModules": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist-client",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "plugins": []
  },
  "include": ["src/client/**/*", "src/shared/**/*", "src/types/**/*", "src/generated/**/*"],
  "exclude": ["node_modules", "dist"]
}