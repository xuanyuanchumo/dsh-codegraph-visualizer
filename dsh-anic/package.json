{
  "name": "dsh-anic",
  "version": "0.3.0",
  "private": false,
  "description": "ANIC — AI-Native Iteration Cycle as a standalone DSH plugin (general-purpose workflow visualizer; this repo is only its first verification ground). Docs: docs/anic/",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "snapshot": "node scripts/generate-snapshot.mjs",
    "build": "node scripts/build-client.mjs",
    "build:watch": "node scripts/build-client.mjs --watch",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/validate-dsh.mjs",
    "validate:dsh": "node scripts/validate-dsh.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --only=vitest",
    "test:smoke": "node scripts/run-tests.mjs --only=smoke",
    "test:live": "node scripts/run-tests.mjs --live",
    "test:dsh:start": "node scripts/start-dsh-test.mjs start",
    "test:dsh:stop": "node scripts/start-dsh-test.mjs stop",
    "test:dsh:restart": "node scripts/start-dsh-test.mjs restart",
    "test:dsh:status": "node scripts/start-dsh-test.mjs status",
    "test:dsh:check": "node scripts/start-dsh-test.mjs check",
    "j0": "node scripts/j0-probe.mjs"
  }
}
