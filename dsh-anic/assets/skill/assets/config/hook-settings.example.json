{
  "hooks": {
    "pre-commit": {
      "command": "bash .codeartsdoer/skills/ai-native-iteration-cycle/assets/hooks/test-protection.sh",
      "description": "测试保护：阻止在测试失败时提交",
      "timeout": 60000
    },
    "pre-push": {
      "command": "bash .codeartsdoer/skills/ai-native-iteration-cycle/assets/hooks/plan-sync-check.sh",
      "description": "计划同步检查：阻止推送与计划不同步的代码",
      "timeout": 30000
    },
    "post-merge": {
      "command": "node .codeartsdoer/skills/ai-native-iteration-cycle/scripts/workflow-state.mjs . status",
      "description": "工作流状态更新：合并后显示当前循环状态",
      "timeout": 10000
    }
  },
  "production-gate": {
    "command": "bash .codeartsdoer/skills/ai-native-iteration-cycle/assets/hooks/production-gate.sh",
    "description": "生产门禁：部署前执行完整门禁检查",
    "timeout": 120000,
    "trigger": "manual"
  }
}